<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<title>Kas Villa</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.47.0/tabler-icons.min.css" />
<style>
  :root {
    --accent:        #7C6FCD;   
    --accent-light:  rgba(124,111,205,0.18);
    --accent-dark:   #4E3FA8;

    --green:         #4ECDC4;
    --green-light:   rgba(78,205,196,0.18);
    --green-dark:    #2A9D94;

    --red:           #E05A7A;
    --red-light:     rgba(224,90,122,0.18);
    --red-dark:      #A83050;

    --blue:          var(--accent);
    --blue-light:    var(--accent-light);
    --blue-dark:     var(--accent-dark);

    --orange:        #f59e0b;
    --orange-light:  rgba(245,158,11,0.15);
    --orange-dark:   #b45309;

    --card:          rgba(10, 10, 28, 0.60);
    --card-border:   rgba(124,111,205,0.30);
    --text:          #E8E6F0;
    --text-muted:    rgba(232,230,240,0.50);
    --border:        rgba(124,111,205,0.22);

    --radius: 14px;
    --shadow: 0 8px 32px rgba(0,0,0,0.5);
    --blur:   blur(16px);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

  body {
    font-family: 'Segoe UI', system-ui, sans-serif;
    background: url('data:image/gif;base64,') no-repeat center center fixed;
    background-size: cover;
    color: var(--text);
    overflow-x: hidden;
    min-height: 100vh;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    background: linear-gradient(
      160deg,
      rgba(5, 5, 20, 0.70) 0%,
      rgba(15, 10, 40, 0.55) 50%,
      rgba(5, 5, 20, 0.72) 100%
    );
    z-index: 0;
    pointer-events: none;
  }

  /* ── TOPBAR ── */
  .topbar {
    background: rgba(8, 8, 25, 0.80);
    backdrop-filter: var(--blur);
    -webkit-backdrop-filter: var(--blur);
    border-bottom: 1px solid var(--card-border);
    color: var(--accent);
    padding: 0.85rem 1.2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 20px rgba(0,0,0,0.5);
  }
  .topbar h2 {
    font-size: 1.1rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    text-shadow: 0 0 18px rgba(124,111,205,0.8);
  }

  /* ── LAYOUT ── */
  .container { width: 100%; max-width: 1100px; margin: 0 auto; padding: 1.2rem; position: relative; z-index: 1; }

  .dashboard-flex { display: flex; flex-direction: column; gap: 15px; margin-bottom: 1.5rem; }
  @media (min-width: 768px) { .dashboard-flex { flex-direction: row; } }

  .summary-side { flex: 1; display: grid; grid-template-columns: 1fr; gap: 10px; }
  @media (min-width: 400px) { .summary-side { grid-template-columns: 1fr 1fr; } .summary-side .s-card:first-child { grid-column: span 2; } }
  @media (min-width: 768px) { .summary-side { display: flex; flex-direction: column; } }

  /* ── GLASS CARDS ── */
  .s-card, .card, .chart-side, .stat-mini-item, .debt-chart-container, .tx-item {
    background: var(--card);
    backdrop-filter: var(--blur);
    -webkit-backdrop-filter: var(--blur);
    border: 1px solid var(--card-border);
    box-shadow: var(--shadow), inset 0 1px 0 rgba(124,111,205,0.15);
    border-radius: var(--radius);
    color: var(--text);
  }

  .s-card { padding: 0.85rem 1rem; }
  .s-label { font-size: 9px; font-weight: 800; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 3px; }
  .s-value { font-size: 1.15rem; font-weight: 800; color: var(--text); }

  .chart-side { flex: 1; padding: 1rem; display: flex; justify-content: center; align-items: center; min-height: 220px; }
  .chart-wrapper { position: relative; height: 180px; width: 180px; }
  .chart-center-text { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; pointer-events: none; width: 80%; }
  .total-label { font-size: 9px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; }
  .total-value { font-size: 1rem; font-weight: 800; color: var(--accent); }

  /* ── TABS ── */
  .tabs {
    display: flex; gap: 5px;
    background: rgba(0,0,0,0.40);
    backdrop-filter: var(--blur);
    -webkit-backdrop-filter: var(--blur);
    padding: 5px; border-radius: var(--radius); margin-bottom: 1rem;
    border: 1px solid var(--border);
  }
  .tab {
    flex: 1; padding: 11px 5px; border: none; background: none; cursor: pointer;
    border-radius: 10px; font-weight: 700; color: var(--text-muted); font-size: 0.82rem;
    display: flex; align-items: center; justify-content: center; gap: 6px; transition: all 0.2s;
  }
  .tab.active {
    background: linear-gradient(135deg, rgba(124,111,205,0.30), rgba(78,63,168,0.20));
    color: #fff;
    border: 1px solid var(--card-border);
    box-shadow: 0 2px 12px rgba(124,111,205,0.3);
    text-shadow: 0 0 10px rgba(124,111,205,0.6);
  }

  /* ── CARD ── */
  .card { padding: 1rem; margin-bottom: 1rem; }

  /* ── TABLE ── */
  .table-wrap { overflow-x: auto; border-radius: 10px; border: 1px solid var(--border); -webkit-overflow-scrolling: touch; }
  table { width: 100%; border-collapse: collapse; min-width: 600px; }
  th { background: rgba(124,111,205,0.15); padding: 10px; font-size: 9px; text-transform: uppercase; font-weight: 800; color: var(--accent); letter-spacing: 1px; }
  td { padding: 12px 10px; border-bottom: 1px solid var(--border); text-align: center; font-size: 0.88rem; color: var(--text); }

  .name-col { text-align: left; font-weight: 700; position: sticky; left: 0; background: rgba(8,8,25,0.90); backdrop-filter: blur(10px); z-index: 5; border-right: 2px solid var(--border); min-width: 140px; }
  .name-actions { display: flex; gap: 8px; margin-top: 6px; }
  .btn-mini {
    padding: 6px; border-radius: 6px; border: 1px solid var(--border);
    background: rgba(124,111,205,0.10); cursor: pointer; font-size: 14px;
    color: var(--text-muted); display: flex; align-items: center; transition: all 0.15s;
  }
  .btn-mini:hover { background: rgba(124,111,205,0.25); color: #fff; }

  /* ── BADGES ── */
  .badge { padding: 3px 9px; border-radius: 20px; font-size: 9px; font-weight: 800; display: inline-block; margin-top: 3px; letter-spacing: 0.5px; }
  .lunas { background: rgba(78,205,196,0.18); color: #7FFFFA; border: 1px solid rgba(78,205,196,0.35); }
  .tunggak { background: rgba(224,90,122,0.18); color: #FFB0C4; border: 1px solid rgba(224,90,122,0.35); }

  /* ── BUTTONS ── */
  .btn {
    padding: 10px 15px; border-radius: 10px; border: none; cursor: pointer;
    font-weight: 700; font-size: 0.88rem; display: flex; align-items: center;
    justify-content: center; gap: 8px; transition: all 0.15s;
  }
  .btn:active { transform: scale(0.96); }
  .btn-blue {
    background: linear-gradient(135deg, var(--accent), var(--accent-dark));
    color: #fff;
    box-shadow: 0 4px 15px rgba(124,111,205,0.40);
  }
  .btn-blue:hover { box-shadow: 0 6px 22px rgba(124,111,205,0.55); }
  .btn-green {
    background: linear-gradient(135deg, var(--green), var(--green-dark));
    color: #fff;
    box-shadow: 0 4px 12px rgba(78,205,196,0.30);
  }
  .btn-outline {
    background: rgba(124,111,205,0.10);
    border: 1px solid var(--border);
    color: var(--text);
  }
  .btn-outline:hover { background: rgba(124,111,205,0.20); }
  .btn-wa { background: linear-gradient(135deg, #25D366, #128C3F); color: white; }

  /* ── INPUTS ── */
  input, select, textarea {
    padding: 12px; border-radius: 10px; border: 1px solid var(--border);
    background: rgba(10,10,28,0.65); backdrop-filter: blur(8px);
    color: var(--text); width: 100%; font-size: 0.95rem; outline: none; transition: border-color 0.2s;
  }
  input::placeholder, textarea::placeholder { color: var(--text-muted); }
  input:focus, select:focus, textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(124,111,205,0.20); }
  select option { background: #0d0d22; color: var(--text); }

  /* ── PAGES ── */
  .page { display: none; }
  .page.active { display: block; animation: fadeIn 0.3s; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

  /* ── TX ITEM ── */
  .tx-item { display: flex; align-items: center; padding: 13px; margin-bottom: 10px; }

  /* ── MODAL ── */
  .modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.80); z-index: 1000; align-items: center; justify-content: center; padding: 1rem; backdrop-filter: blur(10px); }
  .modal-content {
    background: rgba(8,8,25,0.95);
    backdrop-filter: var(--blur);
    border: 1px solid var(--card-border);
    box-shadow: var(--shadow), 0 0 40px rgba(124,111,205,0.2);
    padding: 1.5rem; border-radius: 20px; width: 100%; max-width: 400px; color: var(--text);
  }

  /* ── MINI STATS & MISC ── */
  .input-grid { display: flex; flex-direction: column; gap: 10px; }
  @media (min-width: 600px) { .input-grid { display: grid; grid-template-columns: 2fr 1fr 1fr auto; } }

  .stats-grid-mini { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 10px; margin-top: 1.5rem; margin-bottom: 1.5rem; }
  .stat-mini-item { padding: 12px; text-align: center; }
  .stat-mini-label { font-size: 10px; font-weight: 800; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; }
  .stat-mini-value { font-size: 0.95rem; font-weight: 800; color: var(--accent); }

  .debt-chart-container { margin-bottom: 1.5rem; padding: 1rem; }
  .filter-bar { display: flex; gap: 8px; margin-bottom: 1rem; flex-wrap: wrap; }

  @media print { .no-print { display: none !important; } }
</style>
</head>
<body>

<div class="topbar">
  <h2><i class="ti ti-home-heart"></i> Kas Villa </h2>
  <div style="display:flex; gap:8px;" class="no-print">
    <button class="btn-mini" onclick="window.print()" title="Print"><i class="ti ti-printer"></i></button>
    <button class="btn-mini" style="background: var(--green); color: white; border: none;" onclick="exportToExcel()" title="Excel Semua"><i class="ti ti-file-spreadsheet"></i></button>
    <button class="btn-mini" style="background: var(--orange); color: white; border: none;" onclick="exportPenunggak()" title="Excel Penunggak"><i class="ti ti-user-exclamation"></i></button>
  </div>
</div>

<div class="container">
  <div class="dashboard-flex">
    <div class="summary-side">
      <div class="s-card" style="border-left: 5px solid var(--blue)">
        <div class="s-label">Total Anggota</div>
        <div id="val-members" class="s-value">0</div>
      </div>
      <div class="s-card" style="border-left: 5px solid var(--orange)">
        <div class="s-label">Total Masuk</div>
        <div id="val-masuk" class="s-value">Rp 0</div>
      </div>
      <div class="s-card" style="border-left: 5px solid var(--red)">
        <div class="s-label">Total Keluar</div>
        <div id="val-keluar" class="s-value">Rp 0</div>
      </div>
    </div>

    <div class="chart-side">
      <div class="chart-wrapper">
        <canvas id="summaryChart"></canvas>
        <div class="chart-center-text">
          <div class="total-label">Saldo</div>
          <div id="val-saldo" class="total-value">Rp 0</div>
        </div>
      </div>
    </div>
  </div>

  <div id="debt-section" class="debt-chart-container">
    <h4 style="font-size: 10px; text-transform: uppercase; margin-bottom: 10px; opacity: 0.7;">Top 8 belum lunas</h4>
    <div style="height: 200px;">
        <canvas id="debtChart"></canvas>
    </div>
  </div>

  <div class="tabs no-print">
    <button class="tab active" onclick="showPage('iuran')"><i class="ti ti-users"></i> Anggota</button>
    <button class="tab" onclick="showPage('keluar')"><i class="ti ti-receipt-2"></i> Transaksi</button>
    <button class="tab" onclick="showPage('config')"><i class="ti ti-settings"></i> Atur</button>
  </div>

  <div id="page-iuran" class="page active">
    <div id="mini-stats-container" class="stats-grid-mini"></div>
    <div class="card">
      <div class="no-print" style="display:flex; flex-direction: column; gap:10px; margin-bottom:1rem;">
        <div style="display:flex; gap:8px;">
            <input type="text" id="search-member" placeholder="Cari nama..." onkeyup="render()">
            <button class="btn btn-blue" onclick="addMember()" style="padding: 10px;"><i class="ti ti-plus"></i></button>
        </div>
        <div class="filter-bar">
            <button class="btn btn-outline" style="font-size: 11px; padding: 6px 10px;" onclick="toggleSort()">
                <i class="ti ti-sort-descending-numbers"></i> Urut Tunggakan
            </button>
            <button class="btn btn-outline" id="btn-filter-nunggak" style="font-size: 11px; padding: 6px 10px;" onclick="toggleFilterNunggak()">
                <i class="ti ti-filter"></i> Cuma Nunggak
            </button>
            <button class="btn btn-wa" style="font-size: 11px; padding: 6px 10px;" onclick="broadcastWA()">
                <i class="ti ti-brand-whatsapp"></i> Tagih Semua
            </button>
        </div>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr id="table-head"></tr></thead>
          <tbody id="member-body"></tbody>
        </table>
      </div>
    </div>
  </div>

  <div id="page-keluar" class="page">
    <div class="card no-print">
      <h4 style="margin-bottom:12px; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;">Tambah Transaksi</h4>
      <div class="input-grid">
        <input type="text" id="tx-desc" placeholder="Keterangan">
        <input type="number" id="tx-amount" placeholder="Nominal">
        <select id="tx-type">
          <option value="keluar">Pengeluaran</option>
          <option value="masuk">Pemasukan</option>
        </select>
        <button class="btn btn-blue" onclick="addTx()">Simpan</button>
      </div>
    </div>
    <div id="tx-history"></div>
  </div>

  <div id="page-config" class="page">
    <div class="card">
      <h3 style="font-size: 1.1rem; margin-bottom: 1rem;">Atur Parameter</h3>
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <div><label style="font-size: 11px; font-weight: 700; margin-bottom: 4px; display: block;">JUMLAH MINGGU</label>
        <input type="number" id="conf-count" placeholder="Jml Minggu"></div>
        <div><label style="font-size: 11px; font-weight: 700; margin-bottom: 4px; display: block;">PREFIX (CONTOH: Minggu)</label>
        <input type="text" id="conf-prefix" placeholder="Prefix (M)"></div>
        <div><label style="font-size: 11px; font-weight: 700; margin-bottom: 4px; display: block;">NOMINAL IURAN (RP)</label>
        <input type="number" id="conf-nominal" placeholder="Nominal (Rp)"></div>
      </div>
      <button class="btn btn-blue" style="margin-top:20px; width:100%;" onclick="applyConfig()">Simpan Perubahan</button>
      <hr style="margin: 25px 0; border: 0; border-top: 1px solid var(--border);">
      <h3 style="font-size: 1.1rem;">Ekspor / Impor Data</h3>
      <p style="font-size: 12px; opacity: 0.6; margin: 8px 0 15px;">Gunakan kotak di bawah untuk backup atau memindahkan data ke perangkat teman.</p>
      <textarea id="data-area" style="height: 100px; font-family: monospace; font-size: 10px; margin-bottom: 12px;" placeholder="Data akan muncul di sini saat klik Ekspor..."></textarea>
      <div style="display: flex; gap: 10px;">
        <button class="btn btn-outline" style="flex: 1;" onclick="exportDataManual()">Ekspor</button>
        <button class="btn btn-blue" style="flex: 1;" onclick="importDataManual()">Impor</button>
      </div>
    </div>
  </div>
</div>

<div id="modal-edit" class="modal">
  <div class="modal-content">
    <h3 id="modal-title" style="margin-bottom: 15px;">Edit</h3>
    <input type="hidden" id="edit-id">
    <div style="display:flex; flex-direction:column; gap:12px;">
      <input type="text" id="edit-desc" placeholder="Nama/Keterangan">
      <input type="text" id="edit-phone" placeholder="Nomor WhatsApp (Contoh: 628...)">
      <div id="tx-edit-fields" style="display:none; flex-direction: column; gap: 12px;">
        <input type="number" id="edit-amount" placeholder="Nominal">
        <select id="edit-type">
          <option value="masuk">Pemasukan</option>
          <option value="keluar">Pengeluaran</option>
        </select>
      </div>
      <div style="display:flex; gap:10px; margin-top: 10px;">
        <button class="btn btn-outline" style="flex:1" onclick="closeEdit()">Batal</button>
        <button class="btn btn-blue" style="flex:1" id="save-btn">Simpan</button>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
  let myChart = null;
  let debtChart = null;
  let isSorted = false;
  let isFilterNunggak = false;

  const STORAGE_KEY = 'villa_pro_v5_plus';
  let state = JSON.parse(localStorage.getItem(STORAGE_KEY) || JSON.stringify({
    config: { count: 10, prefix: 'M', nominal: 20000 },
    members: [],
    transactions: []
  }));

  function formatRupiah(num) { return 'Rp ' + Number(num || 0).toLocaleString('id-ID'); }
  function parseDate(d) { const dt = new Date(d || Date.now()); return isNaN(dt)? new Date() : dt; }
  function save() { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); render(); }

  function showPage(p) {
    document.querySelectorAll('.page').forEach(pg => pg.classList.remove('active'));
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.getElementById('page-' + p).classList.add('active');
    if(event) event.currentTarget.classList.add('active');
  }

  function applyConfig() {
    const newCount = parseInt(document.getElementById('conf-count').value) || 10;
    state.config.prefix = document.getElementById('conf-prefix').value || 'M';
    state.config.nominal = parseInt(document.getElementById('conf-nominal').value) || 0;
    state.members.forEach(m => {
      if(m.weeks.length < newCount) { while(m.weeks.length < newCount) m.weeks.push(false); } 
      else if(m.weeks.length > newCount) { m.weeks = m.weeks.slice(0, newCount); }
    });
    state.config.count = newCount;
    save();
  }

  function addMember() {
    const name = prompt("Nama Anggota Baru:");
    if(!name) return;
    const phone = prompt("Nomor WhatsApp (Contoh: 628123...):", "628");
    if(!phone) return;
    state.members.push({ id: Date.now(), name, phone: phone, weeks: Array(state.config.count).fill(false) });
    save();
  }

  function editMember(id) {
    const m = state.members.find(x => x.id === id);
    document.getElementById('modal-title').innerText = "Edit Anggota";
    document.getElementById('edit-id').value = m.id;
    document.getElementById('edit-desc').value = m.name;
    document.getElementById('edit-phone').value = m.phone || "";
    document.getElementById('tx-edit-fields').style.display = 'none';
    document.getElementById('save-btn').onclick = updateMember;
    document.getElementById('modal-edit').style.display = 'flex';
  }

  function updateMember() {
    const id = parseInt(document.getElementById('edit-id').value);
    const m = state.members.find(x => x.id === id);
    m.name = document.getElementById('edit-desc').value;
    m.phone = document.getElementById('edit-phone').value;
    closeEdit(); save();
  }

  function deleteMember(id) {
    const m = state.members.find(x => x.id === id);
    if(confirm(`Hapus anggota ${m.name}?`)) {
      state.members = state.members.filter(x => x.id!== id);
      state.transactions = state.transactions.filter(t =>!t.id.includes(`iuran-${id}`));
      save();
    }
  }

  function toggleWeek(mid, idx) {
    const m = state.members.find(x => x.id === mid);
    const key = `iuran-${mid}-${idx}`;
    if(!m.weeks[idx]) {
      m.weeks[idx] = true;
      state.transactions.unshift({ id: key, type: 'masuk', cat: 'Iuran', desc: `Iuran ${state.config.prefix}${idx+1} - ${m.name}`, amount: state.config.nominal, date: new Date().toISOString() });
    } else {
      if(confirm(`Batalkan iuran ${state.config.prefix}${idx+1} untuk ${m.name}?`)) {
        m.weeks[idx] = false;
        state.transactions = state.transactions.filter(t => t.id!== key);
      }
    }
    save();
  }

  function addTx() {
    const desc = document.getElementById('tx-desc').value;
    const amount = parseInt(document.getElementById('tx-amount').value);
    const type = document.getElementById('tx-type').value;
    if(!desc ||!amount) return;
    state.transactions.unshift({ id: 'manual-' + Date.now(), type, cat: 'Manual', desc, amount, date: new Date().toISOString() });
    document.getElementById('tx-desc').value = '';
    document.getElementById('tx-amount').value = '';
    save();
  }

  function openEditTx(id) {
    const t = state.transactions.find(x => x.id === id);
    document.getElementById('modal-title').innerText = "Edit Transaksi";
    document.getElementById('edit-id').value = t.id;
    document.getElementById('edit-desc').value = t.desc;
    document.getElementById('edit-amount').value = t.amount;
    document.getElementById('edit-type').value = t.type;
    document.getElementById('tx-edit-fields').style.display = 'flex';
    document.getElementById('save-btn').onclick = updateTx;
    document.getElementById('modal-edit').style.display = 'flex';
  }

  function closeEdit() { document.getElementById('modal-edit').style.display = 'none'; }

  function updateTx() {
    const id = document.getElementById('edit-id').value;
    const t = state.transactions.find(x => x.id === id);
    t.desc = document.getElementById('edit-desc').value;
    t.amount = parseInt(document.getElementById('edit-amount').value);
    t.type = document.getElementById('edit-type').value;
    closeEdit(); save();
  }

  function sendWA(name, total, phone) {
    if(!phone || phone === "628") return alert("Nomor WA belum diisi atau tidak valid.");
    const msg = `Halo ${name}, mengingatkan untuk pembayaran cicilan Kas Villa sebesar 20rb dari sisa pembayaran ${formatRupiah(total)}. Terima kasih!`;
    window.open(`https://wa.me/${phone}?text=${encodeURIComponent(msg)}`, '_blank');
  }

  function broadcastWA() {
    const penunggak = state.members.filter(m => m.weeks.filter(w => w).length < state.config.count);
    if(penunggak.length === 0) return alert("Tidak ada penunggak.");
    let list = penunggak.map(m => `- ${m.name} (${formatRupiah((state.config.count - m.weeks.filter(w => w).length) * state.config.nominal)})`).join('%0A');
    const msg = `INFO SISA PEMBAYARAN KAS VILLA%0A%0A${list}%0A%0AMohon segera dicicil. Terima kasih!`;
    window.open(`https://wa.me/?text=${msg}`, '_blank');
  }

  function render() {
    const q = document.getElementById('search-member').value.toLowerCase();
    const masuk = state.transactions.filter(t => t.type === 'masuk').reduce((a,b) => a + b.amount, 0);
    const keluar = state.transactions.filter(t => t.type === 'keluar').reduce((a,b) => a + b.amount, 0);

    document.getElementById('val-members').innerText = state.members.length + " Orang";
    document.getElementById('val-masuk').innerText = formatRupiah(masuk);
    document.getElementById('val-keluar').innerText = formatRupiah(keluar);
    document.getElementById('val-saldo').innerText = formatRupiah(masuk-keluar);

    updateChart(masuk, keluar);

    const miniStatsContainer = document.getElementById('mini-stats-container');
    if (miniStatsContainer) {
        let miniStatsHtml = '';
        for(let i=0; i<state.config.count; i++) {
            const weeklyTotal = state.members.filter(m => m.weeks[i]).length * state.config.nominal;
            miniStatsHtml += `<div class="stat-mini-item"><div class="stat-mini-label">${state.config.prefix}${i+1}</div><div class="stat-mini-value">${weeklyTotal > 0 ? formatRupiah(weeklyTotal) : '-'}</div></div>`;
        }
        miniStatsContainer.innerHTML = miniStatsHtml;
    }

    let head = `<th class="name-col">Anggota</th>`;
    for(let i=1; i<=state.config.count; i++) head += `<th>${state.config.prefix}${i}</th>`;
    document.getElementById('table-head').innerHTML = head;

    let filtered = state.members.map(m => {
        const payCount = m.weeks.filter(w=>w).length;
        const unpaidCount = state.config.count - payCount;
        return {...m, payCount, unpaidCount, totalUnpaid: unpaidCount * state.config.nominal};
    });

    const listNunggak = filtered.filter(f => f.unpaidCount > 0).map(f => ({name: f.name, total: f.totalUnpaid}));
    updateDebtChart(listNunggak);

    if(isFilterNunggak) filtered = filtered.filter(m => m.unpaidCount > 0);
    if(isSorted) filtered.sort((a,b) => b.unpaidCount - a.unpaidCount);
    if(q) filtered = filtered.filter(m => m.name.toLowerCase().includes(q));

    const body = document.getElementById('member-body');
    body.innerHTML = '';
    filtered.forEach(m => {
      const isLunas = m.payCount === state.config.count;
      let statusText = isLunas? `${m.payCount}/${state.config.count} Lunas` : `${m.payCount}/${state.config.count}`;
      let row = `<tr>
        <td class="name-col">
          <div style="font-size: 14px;">${m.name}</div>
          <div class="badge ${isLunas?'lunas':'tunggak'}">${statusText}</div>
          <div class="name-actions no-print">
            <button class="btn-mini" onclick="editMember(${m.id})"><i class="ti ti-pencil"></i></button>
            <button class="btn-mini" onclick="deleteMember(${m.id})"><i class="ti ti-trash"></i></button>
            ${!isLunas ? `<button class="btn-mini" style="color:#25D366" onclick="sendWA('${m.name}', ${m.totalUnpaid}, '${m.phone}')"><i class="ti ti-brand-whatsapp"></i></button>` : ''}
          </div>
        </td>`;
      m.weeks.forEach((w, idx) => {
        row += `<td><input type="checkbox" style="width:18px; height:18px;" ${w?'checked':''} onchange="toggleWeek(${m.id}, ${idx})"></td>`;
      });
      body.innerHTML += row + `</tr>`;
    });

    const hist = document.getElementById('tx-history');
    hist.innerHTML = '';
    state.transactions.forEach(t => {
      hist.innerHTML += `<div class="tx-item"><div style="flex:1"><div style="font-weight:700; font-size:14px;">${t.desc}</div><div style="font-size:10px; opacity:0.5">${parseDate(t.date).toLocaleDateString('id-ID')}</div></div><div style="font-weight:800; color:var(--${t.type==='masuk'?'green':'red'}-dark); margin-right:12px; font-size: 14px;">${t.type==='masuk'?'+':'-'} ${formatRupiah(t.amount)}</div><div class="no-print" style="display:flex; gap:5px;"><button class="btn-mini" onclick="openEditTx('${t.id}')"><i class="ti ti-pencil"></i></button><button class="btn-mini" style="color: var(--red)" onclick="if(confirm('Hapus transaksi ${t.desc}?')){state.transactions=state.transactions.filter(x=>x.id!=='${t.id}');save();}"><i class="ti ti-trash"></i></button></div></div>`;
    });
  }

  function updateChart(masuk, keluar) {
    const ctx = document.getElementById('summaryChart').getContext('2d');
    const data = { labels: ['Masuk', 'Keluar'], datasets: [{ data: [masuk, keluar], backgroundColor: ['#4ECDC4', '#E05A7A'], borderWidth: 0 }] };
    if (myChart) { myChart.data = data; myChart.update(); }
    else { myChart = new Chart(ctx, { type: 'doughnut', data: data, options: { cutout: '80%', plugins: { legend: { display: false } }, responsive: true, maintainAspectRatio: false } }); }
  }

  function updateDebtChart(penunggak) {
    const ctx = document.getElementById('debtChart').getContext('2d');
    const top8 = [...penunggak].sort((a,b) => b.total - a.total).slice(0, 8);
    const data = { labels: top8.map(x => x.name), datasets: [{ label: 'Tunggakan (Rp)', data: top8.map(x => x.total), backgroundColor: '#7C6FCD', borderRadius: 5 }] };
    if (debtChart) { debtChart.data = data; debtChart.update(); }
    else { debtChart = new Chart(ctx, { type: 'bar', data: data, options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { ticks: { color: '#E8E6F0' }, grid: { color: 'rgba(124,111,205,0.12)' } }, y: { ticks: { color: '#E8E6F0' }, grid: { color: 'rgba(124,111,205,0.12)' } } } } }); }
  }

  function exportDataManual() { const dataStr = JSON.stringify(state); const area = document.getElementById('data-area'); area.value = dataStr; navigator.clipboard.writeText(dataStr).then(() => { alert("Data disalin!"); }); area.select(); }
  function importDataManual() { const raw = document.getElementById('data-area').value.trim(); if(!raw) return alert("Tempel data dulu."); try { const parsed = JSON.parse(raw); if(parsed.config && parsed.members) { if(confirm("Timpa data?")) { state = parsed; save(); location.reload(); } } } catch(e) { alert("Gagal impor."); } }
  function toggleSort() { isSorted = !isSorted; render(); }
  function toggleFilterNunggak() { isFilterNunggak = !isFilterNunggak; const btn = document.getElementById('btn-filter-nunggak'); btn.style.background = isFilterNunggak ? 'var(--orange)' : 'transparent'; btn.style.color = isFilterNunggak ? 'white' : 'var(--text)'; render(); }
  function exportToExcel() { const iuranData = state.members.map(m => { let row = { "Nama": m.name }; m.weeks.forEach((w, i) => { row[`${state.config.prefix}${i+1}`] = w? "Lunas" : "-"; }); return row; }); const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(iuranData), "Iuran"); XLSX.writeFile(wb, `Kas_Villa.xlsx`); }
  function exportPenunggak() { const nunggakData = state.members.filter(m => m.weeks.filter(w => w).length < state.config.count).map(m => { const blmBayar = state.config.count - m.weeks.filter(w => w).length; return { "Nama": m.name, "Total Tunggakan (Rp)": blmBayar * state.config.nominal, "Belum Bayar (Minggu)": blmBayar }; }); const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(nunggakData), "Penunggak"); XLSX.writeFile(wb, `Penunggak_Villa.xlsx`); }

  document.getElementById('conf-count').value = state.config.count;
  document.getElementById('conf-prefix').value = state.config.prefix;
  document.getElementById('conf-nominal').value = state.config.nominal;
  render();
</script>
</body>
</html>